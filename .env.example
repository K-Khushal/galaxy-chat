# Copy to .env.local. Validated in lib/env.ts, one concern at a time and only
# when a route uses it: a missing value fails loudly then, not at startup.
# Never put secrets in NEXT_PUBLIC_* variables.
# After setting DATABASE_URL, run `bun run db:migrate` before signing in.

# PostgreSQL connection URI; URL-encode the password.
DATABASE_URL=

# Better Auth (GitHub OAuth). The secret must be at least 32 characters.
# OAuth callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stable keyed identity hashing secret (32+ characters). Do not rotate casually.
CREDIT_IDENTITY_KEY=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
TURNSTILE_SECRET_KEY=
# Public site key; passed explicitly to the sign-in form.
TURNSTILE_SITE_KEY=

# BYOK key encryption (lib/byok/crypto.ts). KEYS_JSON maps a version name to
# canonical base64 of 32 random bytes, e.g. {"v1":"<base64>"}; generate one
# with `openssl rand -base64 32`. ACTIVE_KEY_VERSION picks the version used to
# seal new keys; keep old versions listed until every key is re-saved.
BYOK_ENCRYPTION_KEYS_JSON=
BYOK_ACTIVE_KEY_VERSION=

# Redis TCP/TLS URL, the only Redis setting (Upstash: use the TCP URL, not the
# REST URL/token): rediss://default:<password>@<host>:6379
# Holds auth sessions and sign-in codes, rate limits, Generation locks, Stop
# signals and resumable-stream pub/sub. Needed by sign-in and chat routes.
REDIS_URL=

# The Platform key: an OpenRouter key that serves Replies paid with Credits.
OPENROUTER_API_KEY=

# Additional exact origins allowed for mutations and Better Auth (no paths/wildcards).
# BETTER_AUTH_URL is always included. List www/apex and local ports explicitly.
APP_ORIGINS=
# Vercel supplies VERCEL_ENV, VERCEL_URL and VERCEL_BRANCH_URL automatically.
# Both deployment hosts are included as HTTPS origins only when VERCEL_ENV=preview.

# Opt-in fencing integration test; use a disposable Redis instance.
REDIS_TEST_URL=

# Test-only local E2E runtime. Must be unset for production build/start.
# Requires NODE_ENV=test; rejected on Vercel. See tests/e2e/README.md.
# GALAXY_TEST_E2E=1

# Cloudflare R2 (S3 API) for Attachments. Needed by the attachment routes and
# by Generations that read an attached file. Owner setup: see the README's
# "Attachments (R2)" section: bucket, CORS for PUT from the app origin, and an
# Object Read & Write API token limited to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
