# Copy to .env.local and replace the placeholders. These values are not secrets
# and do not enable any service. Real .env files are gitignored.

# Required together before GitHub sign-in works. If any are missing or the
# secret is shorter than 32 characters, auth stays unconfigured and protected
# server operations fail closed. The static UI still renders.
BETTER_AUTH_SECRET=replace-with-a-local-secret-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
GITHUB_CLIENT_ID=github-oauth-client-id
GITHUB_CLIENT_SECRET=github-oauth-client-secret
DATABASE_URL=postgres://postgres.example:password@aws-0-example.pooler.supabase.com:6543/postgres

# Optional. Comma-separated GitHub logins allowed to use the app. Matching is
# case-insensitive. An empty list invites nobody. The server checks this list
# before creating a session and again on every conversation request. Email and
# password sign-in stays disabled. Expired, revoked, and signed-out sessions
# cannot read or change data. Export and account deletion use that same
# verified session and do not accept a user id from the browser.
GITHUB_INVITE_LOGINS=

# Optional until private storage is used. Server only. Do not prefix these
# with NEXT_PUBLIC and do not put the secret in browser code. This is not
# Supabase Auth.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=server-only-storage-secret
SUPABASE_STORAGE_BUCKET=private

# Platform funding: all amounts are integer USD microdollars (1 USD = 1000000).
# Every field must be explicitly configured; these defaults enable no inference.
# The $10 total cap includes infrastructure, provider/payment fees and reserve.
# No topups/fallbacks. Unknown/expired model prices fail closed.
FUNDED_INFERENCE=0
FUNDED_KILL_SWITCH=1
# Explicit route only. Gateway is implemented but cannot spend platform funds
# until its distinct receipt format and endpoint bounds are verified.
FUNDED_ADAPTER=openrouter
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
CREDIT_ACTOR_SECRET=
PLATFORM_INFRA_MICRODOLLARS=
PLATFORM_PROVIDER_FEES_MICRODOLLARS=
PLATFORM_SAFETY_RESERVE_MICRODOLLARS=
FUNDED_MONTHLY_MICRODOLLARS=
# Only set to 1 after live endpoint token/price/nonreasoning bounds are verified.
FUNDED_PROVIDER_LIMITS_VERIFIED=0
# Server allowlist: one reviewed BASIC text-only, nonreasoning endpoint snapshot.
# Empty by default. Example shape below uses intentionally nonfunctional names:
# {"id":"reviewed-price-snapshot","model":"example/basic","provider":"example","expiresAt":"YYYY-MM-DDTHH:mm:ssZ","inputMicrodollarsPerMillion":1,"outputMicrodollarsPerMillion":1,"basicTextOnly":true,"reasoning":"none","allInPrice":true}
FUNDED_BASIC_PRICE_JSON=

# Guest APIs are isolated from Better Auth and never persist chats/memory.
# Requires a provisioned Turnstile widget with action galaxy_guest, server secret,
# HTTPS BETTER_AUTH_URL hostname, and a Cloudflare-only origin (no public bypass).
# Never trust CF-Connecting-IP on an origin directly reachable by visitors.
# No widget/account is provisioned by this repository.
GUEST_COOKIE_SECRET=
GUEST_TURNSTILE_SECRET=
# Public widget identifier only. Blank/invalid keeps the guest UI disabled.
GUEST_TURNSTILE_SITE_KEY=
GUEST_TRUSTED_PROXY=
GUEST_ORIGIN_IS_PROXY_ONLY=0

# Optional. Set to 1 to expose the local /spike/f01 route. Any other value
# hides it.
F01_PROTOTYPE=0

# Local-only F04 visual harness. Requires NODE_ENV=development; never bypasses /chat auth.
F04_UI_HARNESS=0

# User-supplied OpenRouter / Vercel Gateway keys, server only. Empty defaults
# allow builds but disable BYOK. Use secret management, separately from the DB.
BYOK_ENABLED=0
# Canonical base64 of 32 cryptographically random bytes per version. No real key here.
BYOK_ENCRYPTION_KEYS_JSON=
BYOK_ACTIVE_KEY_VERSION=
# Independent, stable HMAC secret (>=32 characters) for anonymous resource leases.
# Do not rotate it with encryption keys or reset it while any lease is unresolved.
BYOK_RESOURCE_SECRET=
# Explicit operator-reviewed text model routes. At most 100 entries. No price assumption.
# [{"id":"operator-model-id","name":"Reviewed text model","adapter":"openrouter","model":"example/model","provider":"example","verified":true,"expiresAt":"YYYY-MM-DDTHH:mm:ssZ","capabilities":{"text":true,"reasoning":false,"sources":false,"files":false,"tools":false,"search":false}}]
# gateway uses the same shape with adapter=gateway. No client provider options.
BYOK_MODELS_JSON=
